+            CandidateDiagnostic(
+                decision=CandidateDecision.ACCEPTED_WALL,
+                reason="parallel filled edge pair",
+                length=start.distance_to(end),
+                thickness=reconstructed[-1].half_width * 2.0,
+                continuity=fill,
